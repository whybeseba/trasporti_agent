# Copia questo file in ".env" e compila i valori reali.
# Il file .env NON va mai committato (è già nel .gitignore).

# ── PostgreSQL ──────────────────────────────────────────────────────────
# La stessa password in ENTRAMBE le righe.
POSTGRES_PASSWORD=ScegliUnaPasswordLungaECasuale
DATABASE_URL=postgresql+psycopg2://trasporti:ScegliUnaPasswordLungaECasuale@localhost:5432/trasporti

# ── Motore vLLM su OVH AI Deploy ────────────────────────────────────────
# Configurazione MOTORE UNICO (vedi Deploy_due_modelli_vLLM_AI_Deploy.md,
# "Quello da usare per il primo test"): un endpoint per tutti i ruoli.
# URL dell'app AI Deploy CON /v1 finale (dimenticarlo è l'errore più comune).
VLLM_URL=https://<ID_APP>.app.gra.ai.cloud.ovh.net/v1
# Token AI Deploy (creato con: ovhai token create ... --label-selector ai_deploy_token=...)
VLLM_TOKEN=<IL_TUO_TOKEN>
# Nome "pubblico" del modello, fissato all'avvio dell'app con --served-model-name
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B

# Configurazione DUE MOTORI (orchestratore 27B + sub-agenti 9B): scommenta
# e compila quando accendi le due app — il codice li usa da solo, per ruolo.
# VLLM_URL_ORCHESTRATORE=https://<ID_APP_ORCH>.app.gra.ai.cloud.ovh.net/v1
# VLLM_MODEL_ORCHESTRATORE=Qwen/Qwen3.6-27B
# VLLM_URL_SUBAGENTI=https://<ID_APP_SUB>.app.gra.ai.cloud.ovh.net/v1
# VLLM_MODEL_SUBAGENTI=Qwen/Qwen3.5-9B

# ── ChromaDB (RAG agente Normativa) ─────────────────────────────────────
# Opzionali: questi sono già i default nel codice, scommenta solo se cambi
# porta o host nel docker-compose.
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
